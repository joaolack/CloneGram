{
  "openapi": "3.0.3",
  "info": {
    "title": "ProjetoFinal API",
    "description": "Documentacao da API do ProjetoFinal para autenticacao, perfis, posts, curtidas, comentarios e busca.",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "/api",
      "description": "Mesmo host da documentacao local"
    },
    {
      "url": "http://localhost:8000/api",
      "description": "Servidor local padrao do Laravel"
    }
  ],
  "tags": [
    {
      "name": "Auth",
      "description": "Cadastro, login e sessao"
    },
    {
      "name": "Perfil",
      "description": "Consulta e atualizacao de perfis"
    },
    {
      "name": "Usuarios",
      "description": "Busca e relacionamento entre usuarios"
    },
    {
      "name": "Home",
      "description": "Feed inicial"
    },
    {
      "name": "Posts",
      "description": "Publicacoes"
    },
    {
      "name": "Curtidas",
      "description": "Curtidas em posts"
    },
    {
      "name": "Comentarios",
      "description": "Comentarios em posts"
    }
  ],
  "paths": {
    "/register": {
      "post": {
        "tags": [
          "Auth"
        ],
        "summary": "Cadastrar usuario",
        "operationId": "register",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RegisterRequest"
              },
              "example": {
                "name": "Joao Silva",
                "username": "joaosilva",
                "email": "joao@example.com",
                "password": "senha1234",
                "password_confirmation": "senha1234"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Usuario cadastrado e token emitido",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuthResponse"
                }
              }
            }
          },
          "422": {
            "$ref": "#/components/responses/ValidationError"
          }
        }
      }
    },
    "/login": {
      "post": {
        "tags": [
          "Auth"
        ],
        "summary": "Autenticar usuario",
        "operationId": "login",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginRequest"
              },
              "example": {
                "email": "joao@example.com",
                "password": "senha1234"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Login realizado e token emitido",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuthResponse"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "422": {
            "$ref": "#/components/responses/ValidationError"
          },
          "429": {
            "$ref": "#/components/responses/TooManyRequests"
          }
        }
      }
    },
    "/me": {
      "get": {
        "tags": [
          "Auth"
        ],
        "summary": "Consultar usuario autenticado",
        "operationId": "me",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Usuario autenticado",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UserResource"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          }
        }
      }
    },
    "/logout": {
      "post": {
        "tags": [
          "Auth"
        ],
        "summary": "Encerrar token atual",
        "operationId": "logout",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "204": {
            "description": "Logout realizado"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          }
        }
      }
    },
    "/logout-all": {
      "post": {
        "tags": [
          "Auth"
        ],
        "summary": "Encerrar todos os tokens do usuario",
        "operationId": "logoutAll",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "204": {
            "description": "Todos os tokens foram encerrados"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          }
        }
      }
    },
    "/profile": {
      "get": {
        "tags": [
          "Perfil"
        ],
        "summary": "Consultar proprio perfil",
        "operationId": "getOwnProfile",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Perfil autenticado",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UserResource"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          }
        }
      },
      "put": {
        "tags": [
          "Perfil"
        ],
        "summary": "Atualizar proprio perfil",
        "operationId": "updateProfile",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "multipart/form-data": {
              "schema": {
                "$ref": "#/components/schemas/UpdateProfileRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Perfil atualizado",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UserResource"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "422": {
            "$ref": "#/components/responses/ValidationError"
          }
        }
      }
    },
    "/users": {
      "get": {
        "tags": [
          "Usuarios"
        ],
        "summary": "Buscar usuarios",
        "operationId": "searchUsers",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "search",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "maxLength": 100
            },
            "description": "Termo para buscar por nome ou username"
          },
          {
            "name": "page",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Usuarios encontrados",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PaginatedUsers"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "422": {
            "$ref": "#/components/responses/ValidationError"
          }
        }
      }
    },
    "/users/{username}": {
      "get": {
        "tags": [
          "Perfil"
        ],
        "summary": "Consultar perfil de usuario",
        "operationId": "getUserProfile",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/UsernamePath"
          }
        ],
        "responses": {
          "200": {
            "description": "Perfil do usuario",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UserResource"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          }
        }
      }
    },
    "/users/{username}/follow": {
      "post": {
        "tags": [
          "Usuarios"
        ],
        "summary": "Seguir usuario",
        "operationId": "followUser",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/UsernamePath"
          }
        ],
        "responses": {
          "201": {
            "description": "Usuario seguido",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MessageResponse"
                },
                "example": {
                  "message": "Usuario seguido com sucesso"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          }
        }
      },
      "delete": {
        "tags": [
          "Usuarios"
        ],
        "summary": "Deixar de seguir usuario",
        "operationId": "unfollowUser",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/UsernamePath"
          }
        ],
        "responses": {
          "204": {
            "description": "Usuario deixou de ser seguido"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          }
        }
      }
    },
    "/home": {
      "get": {
        "tags": [
          "Home"
        ],
        "summary": "Consultar feed inicial",
        "operationId": "home",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Posts e sugestoes para o usuario",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HomeResponse"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          }
        }
      }
    },
    "/posts": {
      "get": {
        "tags": [
          "Posts"
        ],
        "summary": "Listar posts",
        "operationId": "listPosts",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "page",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Posts paginados",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PaginatedPosts"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          }
        }
      },
      "post": {
        "tags": [
          "Posts"
        ],
        "summary": "Criar post",
        "operationId": "createPost",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "multipart/form-data": {
              "schema": {
                "$ref": "#/components/schemas/StorePostRequest"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Post criado",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PostResource"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "422": {
            "$ref": "#/components/responses/ValidationError"
          }
        }
      }
    },
    "/posts/{post}": {
      "get": {
        "tags": [
          "Posts"
        ],
        "summary": "Consultar post",
        "operationId": "getPost",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/PostPath"
          }
        ],
        "responses": {
          "200": {
            "description": "Post encontrado",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PostResource"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          }
        }
      },
      "delete": {
        "tags": [
          "Posts"
        ],
        "summary": "Excluir post",
        "operationId": "deletePost",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/PostPath"
          }
        ],
        "responses": {
          "204": {
            "description": "Post excluido"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          }
        }
      }
    },
    "/posts/{post}/like": {
      "post": {
        "tags": [
          "Curtidas"
        ],
        "summary": "Curtir post",
        "operationId": "likePost",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/PostPath"
          }
        ],
        "responses": {
          "201": {
            "description": "Post curtido",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MessageResponse"
                },
                "example": {
                  "message": "Post curtido com sucesso"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          }
        }
      },
      "delete": {
        "tags": [
          "Curtidas"
        ],
        "summary": "Remover curtida do post",
        "operationId": "unlikePost",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/PostPath"
          }
        ],
        "responses": {
          "204": {
            "description": "Curtida removida"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          }
        }
      }
    },
    "/post/{post}/comments": {
      "get": {
        "tags": [
          "Comentarios"
        ],
        "summary": "Listar comentarios de um post",
        "operationId": "listPostComments",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/PostPath"
          }
        ],
        "responses": {
          "200": {
            "description": "Comentarios do post",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CommentCollection"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          }
        }
      }
    },
    "/posts/{post}/comments": {
      "post": {
        "tags": [
          "Comentarios"
        ],
        "summary": "Criar comentario em post",
        "operationId": "createPostComment",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/PostPath"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/StoreCommentRequest"
              },
              "example": {
                "content": "Muito bom!"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Comentario criado",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CommentResource"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "422": {
            "$ref": "#/components/responses/ValidationError"
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "Sanctum token"
      }
    },
    "parameters": {
      "PostPath": {
        "name": "post",
        "in": "path",
        "required": true,
        "schema": {
          "type": "integer",
          "minimum": 1
        },
        "description": "ID do post"
      },
      "UsernamePath": {
        "name": "username",
        "in": "path",
        "required": true,
        "schema": {
          "type": "string"
        },
        "description": "Username do usuario"
      }
    },
    "schemas": {
      "RegisterRequest": {
        "type": "object",
        "required": [
          "name",
          "username",
          "email",
          "password",
          "password_confirmation"
        ],
        "properties": {
          "name": {
            "type": "string",
            "maxLength": 255
          },
          "username": {
            "type": "string",
            "maxLength": 255
          },
          "email": {
            "type": "string",
            "format": "email",
            "maxLength": 255
          },
          "password": {
            "type": "string",
            "format": "password",
            "minLength": 8,
            "description": "Deve conter letras e numeros"
          },
          "password_confirmation": {
            "type": "string",
            "format": "password"
          }
        }
      },
      "LoginRequest": {
        "type": "object",
        "required": [
          "email",
          "password"
        ],
        "properties": {
          "email": {
            "type": "string",
            "format": "email"
          },
          "password": {
            "type": "string",
            "format": "password"
          }
        }
      },
      "UpdateProfileRequest": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "maxLength": 255
          },
          "username": {
            "type": "string",
            "maxLength": 50,
            "description": "Aceita letras, numeros, tracos e underscores"
          },
          "bio": {
            "type": "string",
            "nullable": true,
            "maxLength": 255
          },
          "avatar": {
            "type": "string",
            "format": "binary",
            "nullable": true,
            "description": "Imagem jpg, jpeg, png ou webp com ate 5 MB"
          }
        }
      },
      "StorePostRequest": {
        "type": "object",
        "required": [
          "media"
        ],
        "properties": {
          "media": {
            "type": "string",
            "format": "binary",
            "description": "Imagem jpg, jpeg, png, webp ou video mp4/mov com ate 50 MB"
          },
          "caption": {
            "type": "string",
            "nullable": true,
            "maxLength": 2200
          }
        }
      },
      "StoreCommentRequest": {
        "type": "object",
        "required": [
          "content"
        ],
        "properties": {
          "content": {
            "type": "string",
            "maxLength": 1000
          }
        }
      },
      "AuthResponse": {
        "type": "object",
        "properties": {
          "user": {
            "$ref": "#/components/schemas/User"
          },
          "token": {
            "type": "string"
          },
          "token_type": {
            "type": "string",
            "example": "Bearer"
          },
          "expires_at": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          }
        }
      },
      "UserResource": {
        "type": "object",
        "properties": {
          "data": {
            "$ref": "#/components/schemas/User"
          }
        }
      },
      "PostResource": {
        "type": "object",
        "properties": {
          "data": {
            "$ref": "#/components/schemas/Post"
          }
        }
      },
      "CommentResource": {
        "type": "object",
        "properties": {
          "data": {
            "$ref": "#/components/schemas/Comment"
          }
        }
      },
      "User": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "example": 1
          },
          "name": {
            "type": "string",
            "example": "Joao Silva"
          },
          "username": {
            "type": "string",
            "example": "joaosilva"
          },
          "email": {
            "type": "string",
            "format": "email",
            "nullable": true,
            "example": "joao@example.com"
          },
          "bio": {
            "type": "string",
            "nullable": true
          },
          "avatar_url": {
            "type": "string",
            "format": "uri",
            "nullable": true
          },
          "posts_count": {
            "type": "integer",
            "nullable": true
          },
          "followers_count": {
            "type": "integer",
            "nullable": true
          },
          "following_count": {
            "type": "integer",
            "nullable": true
          },
          "is_following": {
            "type": "boolean",
            "nullable": true
          },
          "posts": {
            "type": "array",
            "nullable": true,
            "items": {
              "$ref": "#/components/schemas/Post"
            }
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          }
        }
      },
      "Post": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "example": 1
          },
          "caption": {
            "type": "string",
            "nullable": true
          },
          "media_url": {
            "type": "string",
            "format": "uri"
          },
          "media_type": {
            "type": "string",
            "enum": [
              "image",
              "video"
            ]
          },
          "author": {
            "allOf": [
              {
                "$ref": "#/components/schemas/User"
              }
            ],
            "nullable": true
          },
          "likes_count": {
            "type": "integer",
            "nullable": true
          },
          "comments_count": {
            "type": "integer",
            "nullable": true
          },
          "liked_by_me": {
            "type": "boolean",
            "nullable": true
          },
          "comments": {
            "type": "array",
            "nullable": true,
            "items": {
              "$ref": "#/components/schemas/Comment"
            }
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          },
          "updated_at": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          }
        }
      },
      "Comment": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "example": 1
          },
          "content": {
            "type": "string",
            "example": "Muito bom!"
          },
          "author": {
            "allOf": [
              {
